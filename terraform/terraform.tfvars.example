# Copy this file to terraform.tfvars (gitignored) and fill in real values to
# provision actual infrastructure. Never commit terraform.tfvars.

# Point at your real org if you want to actually apply this.
org_id = "o-yourrealorgid"

# Real Grafana Cloud stack.
grafana_cloud_stack_slug          = "yourstackname"
grafana_cloud_access_policy_token = "glc_..."
grafana_aws_external_id           = "..."
grafana_labs_aws_account_id       = "..." # from Grafana's CloudWatch data source docs

# Approach 3 (Metric Streams -> Firehose -> Grafana Cloud directly) needs no
# extra variables — the endpoint, Prometheus user ID, and a metrics:write
# access policy token are all derived/created automatically in grafana.tf
# from the grafana_cloud_stack_slug above.

# --- Real-infra switches ---
# Both default to false; set true only when you intend to provision and pay
# for real resources.

create_account            = true
demo_account_name         = "cloudwatch-demo"
demo_account_email        = "aws+cloudwatch-demo@yourdomain.example"
demo_account_parent_ou_id = "ou-xxxx-xxxxxxxx"

create_ec2_instances = true
allowed_ssh_cidr     = "203.0.113.10/32" # your own IP, not 0.0.0.0/0
